From 572a3fa0645216ff2f503105112138d43229c957 Mon Sep 17 00:00:00 2001
From: lutyjj <10267813+lutyjj@users.noreply.github.com>
Date: Wed, 5 Aug 2026 19:41:28 +0000
Subject: [PATCH 2/2] fix(audio): tolerate timerfd wakeups with no expirations

The audio clock's timerfd read propagated EAGAIN as a fatal error,
shutting the whole session down (PulseServerStopped) and killing the
running application with it. A wakeup can race its own drain and find
no expirations left to read - hit in the wild under host memory
pressure, where a stalling event loop ended a live 4K session mid-game.
Skip the tick instead, matching the WouldBlock handling in the accept
and client-read arms of the same loop.
---
 .../src/session/stream/audio/pulse_server/mod.rs         | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/moonshine-core/src/session/stream/audio/pulse_server/mod.rs b/moonshine-core/src/session/stream/audio/pulse_server/mod.rs
index 7da7e40..5d09eac 100644
--- a/moonshine-core/src/session/stream/audio/pulse_server/mod.rs
+++ b/moonshine-core/src/session/stream/audio/pulse_server/mod.rs
@@ -368,8 +368,13 @@ impl PulseServer {
 			for event in events.iter() {
 				match event.token() {
 					CLOCK => {
-						self.clock.read()?;
-						self.clock_tick()?;
+						// A wakeup can race its own drain and find no expirations
+						// left to read (EAGAIN); skip the tick, don't kill the session.
+						match self.clock.read() {
+							Ok(_) => self.clock_tick()?,
+							Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => (),
+							Err(e) => return Err(e.into()),
+						}
 					},
 					LISTENER => loop {
 						let (mut socket, _) = match self.listener.accept() {
