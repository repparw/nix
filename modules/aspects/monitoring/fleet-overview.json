{
  "uid": "fleet-overview",
  "title": "Fleet Overview",
  "tags": [
    "fleet",
    "nixos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (host) (rate(node_cpu_seconds_total{job=\"integrations/unix\",mode!=\"idle\"}[5m])) / sum by (host) (rate(node_cpu_seconds_total{job=\"integrations/unix\"}[5m]))",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Filesystem used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, device) (100 * (node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint=~\"/|/persist|/nix|/home/repparw\"} - node_filesystem_free_bytes) / (node_filesystem_size_bytes - node_filesystem_free_bytes + node_filesystem_avail_bytes))",
          "legendFormat": "{{host}} {{device}}",
          "interval": ""
        }
      ],
      "description": "Used space divided by used plus unprivileged available space, matching df before rounding. Bind mounts on the same host and device are shown once."
    },
    {
      "id": 4,
      "title": "Uplink receive (bytes/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{device=~\"eth[0-9]+|en.*|wl.*\"}[5m]))",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ],
      "description": "Ethernet and Wi-Fi traffic. Excludes loopback, container bridges, WireGuard and IFB traffic-shaping interfaces to avoid counting packets twice."
    },
    {
      "id": 5,
      "title": "Uplink transmit (bytes/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate(node_network_transmit_bytes_total{device=~\"eth[0-9]+|en.*|wl.*\"}[5m]))",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ],
      "description": "Ethernet and Wi-Fi traffic. Excludes loopback, container bridges, WireGuard and IFB traffic-shaping interfaces to avoid counting packets twice."
    },
    {
      "id": 6,
      "title": "Failed jobs or services",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host) (fleet_failed_units) or on(host) sum by (host) (node_systemd_unit_state{state=\"failed\"})",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ],
      "description": "Loaded failed units and retained failed job results. Before the host collector was installed, historical samples contain loaded units only."
    },
    {
      "id": 7,
      "title": "Missing host telemetry (1 = missing)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "absent_over_time(node_uname_info{host=\"alpha\"}[5m]) or on(host) label_replace(vector(0), \"host\", \"alpha\", \"\", \"\")",
          "legendFormat": "alpha",
          "interval": ""
        },
        {
          "refId": "B",
          "expr": "absent_over_time(node_uname_info{host=\"pi\"}[5m]) or on(host) label_replace(vector(0), \"host\", \"pi\", \"\", \"\")",
          "legendFormat": "pi",
          "interval": ""
        },
        {
          "refId": "C",
          "expr": "absent_over_time(node_uname_info{host=\"epsilon\"}[5m]) or on(host) label_replace(vector(0), \"host\", \"epsilon\", \"\", \"\")",
          "legendFormat": "epsilon",
          "interval": ""
        }
      ]
    },
    {
      "id": 8,
      "title": "Swap used (bytes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    }
  ]
}
