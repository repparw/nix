{
  "uid": "fleet-overview",
  "title": "Fleet Overview",
  "tags": [
    "fleet",
    "nixos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Filesystem used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=~\"/|/persist|/nix|/home/repparw\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint=~\"/|/persist|/nix|/home/repparw\"})",
          "legendFormat": "{{host}} {{mountpoint}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Network receive (bytes/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{device=~\"eth0|wg-home\"}[5m]))",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "Network transmit (bytes/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate(node_network_transmit_bytes_total{device=~\"eth0|wg-home\"}[5m]))",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed systemd units",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (node_systemd_unit_state{state=\"failed\"})",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 7,
      "title": "Scrape targets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node\"}",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    },
    {
      "id": 8,
      "title": "Swap used (bytes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "{{host}}",
          "interval": ""
        }
      ]
    }
  ]
}
