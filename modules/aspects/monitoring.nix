{ den, ... }:
{
  # A host-side collector. Only Epsilon may scrape it; no exporter port is
  # opened by the NixOS exporter module's broad openFirewall switch.
  den.aspects.monitoring.provides.agent.nixos =
    { config, lib, ... }:
    let
      isCollector = config.networking.hostName == "epsilon";
      epsilon = config.modules.services.hostAddresses.epsilon;
    in
    {
      services.prometheus.exporters.node = {
        enable = true;
        port = 9100;
        listenAddress = if isCollector then "127.0.0.1" else "0.0.0.0";
        openFirewall = false;
        enabledCollectors = [ "systemd" "textfile" ];
        extraFlags = [
          "--collector.textfile.directory=/var/lib/node-exporter/textfile"
        ] ++ lib.optionals (config.networking.hostName == "alpha") [
          # Override upstream's default exclusion to add sleeping HDD
          # automounts. Statfs on these mountpoints can wake the disks.
          "--collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run/credentials/.+|var/lib/docker/.+|var/lib/containers/storage/.+|mnt/hdd|mnt/seagate|home/containers/media/hdd|home/containers/media/seagate)(/|$)"
        ];
      };

      # Ship the host's systemd journal to the central Loki instance.
      # Entries already sent persist on Epsilon across Pi reboots even
      # though the Pi journal remains volatile.
      services.alloy = {
        enable = true;
        extraFlags = [
          "--server.http.listen-addr=127.0.0.1:12345"
          "--disable-reporting"
        ];
      };

      environment.etc."alloy/config.alloy".text = ''
        // Journald metadata is internal until explicitly promoted to labels.
        // Keep labels low-cardinality (never PID, cursor, command line).
        loki.relabel "journal" {
          forward_to = []

          rule {
            source_labels = ["__journal__systemd_unit"]
            target_label  = "unit"
          }
          rule {
            source_labels = ["__journal_priority_keyword"]
            target_label  = "level"
          }
          rule {
            source_labels = ["__journal_syslog_identifier"]
            target_label  = "identifier"
          }
        }

        loki.source.journal "host" {
          forward_to    = [loki.secretfilter.journal.receiver]
          relabel_rules = loki.relabel.journal.rules
          labels        = { host = "${config.networking.hostName}", source = "journald" }
          max_age       = "12h"
        }

        // Redact common leaked credentials. This is best-effort, not
        // proof that arbitrary sensitive content cannot be collected.
        loki.secretfilter "journal" {
          forward_to    = [loki.write.epsilon.receiver]
          redact_percent = 100
        }

        loki.write "epsilon" {
          endpoint {
            url                 = "http://${if isCollector then "127.0.0.1" else epsilon}:3100/loki/api/v1/push"
            max_backoff_retries = 0
          }
        }
      '';

      systemd.tmpfiles.rules = [
        "d /var/lib/node-exporter/textfile 0755 root root - -"
      ];

      networking.firewall.extraInputRules = lib.mkIf (!isCollector) ''
        iifname "eth0" ip saddr ${epsilon} tcp dport 9100 accept comment "epsilon prometheus scrape"
      '';
    };

  # Epsilon is the independent collector: it remains online when the home
  # power or uplink is down. Service routing is generated by the existing
  # registry / Traefik / Authelia integration.
  den.aspects.monitoring.provides.server = {
    includes = [ den.aspects.monitoring._.agent ];
    service-registry = {
      name = "grafana";
      definition = {
        hostname = "metrics";
        port = 3001;
        auth = "one_factor";
        monitor = true;
        healthcheck = "/api/health";
      };
    };

    nixos =
      { config, lib, pkgs, ... }:
      let
        cfg = config.modules.services;
        dashboardDir = pkgs.runCommand "fleet-grafana-dashboards" { } ''
          mkdir -p "$out"
          cp ${./monitoring/fleet-overview.json} "$out/fleet-overview.json"
        '';
      in
      {
        services.prometheus = {
          enable = true;
          listenAddress = "127.0.0.1";
          port = 9090;
          stateDir = "prometheus2";
          retentionTime = "30d";
          extraFlags = [ "--storage.tsdb.retention.size=3GB" ];
          globalConfig.scrape_interval = "30s";
          scrapeConfigs = [
            {
              job_name = "node";
              static_configs = map (host: {
                targets = [
                  "${if host == "epsilon" then "127.0.0.1" else cfg.hostAddresses.${host}}:9100"
                ];
                labels.host = host;
              }) [ "alpha" "pi" "epsilon" ];
            }
          ];
        };

        # Single-process Loki with local TSDB index and chunk storage.
        # Retention is time-based, not a hard size cap.
        services.loki = {
          enable = true;
          configuration = {
            auth_enabled = false; # Private WireGuard peers plus localhost only.
            server = {
              http_listen_address = "0.0.0.0";
              http_listen_port = 3100;
            };
            common = {
              path_prefix = "/var/lib/loki";
              ring = {
                instance_addr = "127.0.0.1";
                kvstore.store = "inmemory";
              };
              replication_factor = 1;
            };
            schema_config.configs = [
              {
                from = "2024-01-01";
                store = "tsdb";
                object_store = "filesystem";
                schema = "v13";
                index = {
                  prefix = "index_";
                  period = "24h";
                };
              }
            ];
            storage_config.filesystem.directory = "/var/lib/loki/chunks";
            limits_config = {
              retention_period = "168h"; # 7 days
              max_query_lookback = "168h";
            };
            compactor = {
              working_directory = "/var/lib/loki/compactor";
              retention_enabled = true;
              delete_request_store = "filesystem";
            };
          };
        };

        # Loki has no authentication in single-tenant mode. Only the
        # private home tunnel and these two source hosts may ingest.
        networking.firewall.extraInputRules = ''
          iifname "wg-home" ip saddr { ${cfg.hostAddresses.pi}, ${cfg.hostAddresses.alpha} } tcp dport 3100 accept comment "private fleet Alloy to Loki"
        '';

        services.grafana = {
          enable = true;
          openFirewall = false;
          settings = {
            server = {
              http_addr = "127.0.0.1";
              http_port = 3001;
              domain = "metrics.${cfg.domain}";
              root_url = "https://metrics.${cfg.domain}/";
              enforce_domain = true;
            };
            security = {
              # File provider keeps the password out of the Nix store. The
              # first-start secret is generated below and persisted on disk.
              admin_password = "$__file{/var/lib/grafana/admin-password}";
              cookie_secure = true;
              disable_gravatar = true;
            };
            users.allow_sign_up = false;
            analytics = {
              reporting_enabled = false;
              check_for_updates = false;
            };
          };
          provision = {
            enable = true;
            datasources.settings = {
              apiVersion = 1;
              datasources = [
                {
                  name = "Prometheus";
                  type = "prometheus";
                  access = "proxy";
                  url = "http://127.0.0.1:9090";
                  uid = "fleet-prom";
                  isDefault = true;
                  editable = false;
                }
                {
                  name = "Loki";
                  type = "loki";
                  access = "proxy";
                  url = "http://127.0.0.1:3100";
                  uid = "fleet-loki";
                  isDefault = false;
                  editable = false;
                }
              ];
            };
            dashboards.settings = {
              apiVersion = 1;
              providers = [
                {
                  name = "Fleet";
                  type = "file";
                  disableDeletion = true;
                  editable = false;
                  options.path = dashboardDir;
                }
              ];
            };
          };
        };

        systemd.services.grafana.preStart = lib.mkBefore ''
          if [ ! -s /var/lib/grafana/admin-password ]; then
            umask 077
            ${pkgs.coreutils}/bin/head -c 32 /dev/urandom | ${pkgs.coreutils}/bin/base64 -w0 > /var/lib/grafana/admin-password
          fi
        '';

        # Epsilon has a tmpfs root. Without these binds Grafana's SQLite DB,
        # first-start credentials and all Prometheus metrics vanish on reboot.
        environment.persistence."/persist".directories = [
          {
            directory = "/var/lib/grafana";
            user = "grafana";
            group = "grafana";
            mode = "0750";
          }
          {
            directory = "/var/lib/loki";
            user = "loki";
            group = "loki";
            mode = "0750";
          }
          {
            directory = "/var/lib/prometheus2";
            user = "prometheus";
            group = "prometheus";
            mode = "0750";
          }
        ];
      };
  };
}
