{ den, ... }:
{
  # A host-side collector. Only Epsilon may scrape it; no exporter port is
  # opened by the NixOS exporter module's broad openFirewall switch.
  den.aspects.monitoring.provides.agent.nixos =
    { config, lib, ... }:
    let
      isCollector = config.networking.hostName == "epsilon";
      epsilon = config.modules.services.hostAddresses.epsilon;
    in
    {
      services.prometheus.exporters.node = {
        enable = true;
        port = 9100;
        listenAddress = if isCollector then "127.0.0.1" else "0.0.0.0";
        openFirewall = false;
        enabledCollectors = [ "systemd" "textfile" ];
        extraFlags = [
          "--collector.textfile.directory=/var/lib/node-exporter/textfile"
        ] ++ lib.optionals (config.networking.hostName == "alpha") [
          # Override upstream's default exclusion to add sleeping HDD
          # automounts. Statfs on these mountpoints can wake the disks.
          "--collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run/credentials/.+|var/lib/docker/.+|var/lib/containers/storage/.+|mnt/hdd|mnt/seagate|home/containers/media/hdd|home/containers/media/seagate)(/|$)"
        ];
      };

      systemd.tmpfiles.rules = [
        "d /var/lib/node-exporter/textfile 0755 node-exporter node-exporter - -"
      ];

      networking.firewall.extraInputRules = lib.mkIf (!isCollector) ''
        iifname "eth0" ip saddr ${epsilon} tcp dport 9100 accept comment "epsilon prometheus scrape"
      '';
    };

  # Epsilon is the independent collector: it remains online when the home
  # power or uplink is down. Service routing is generated by the existing
  # registry / Traefik / Authelia integration.
  den.aspects.monitoring.provides.server = {
    includes = [ den.aspects.monitoring._.agent ];
    service-registry = {
      name = "grafana";
      definition = {
        hostname = "metrics";
        port = 3001;
        auth = "one_factor";
        monitor = true;
        healthcheck = "/api/health";
      };
    };

    nixos =
      { config, lib, pkgs, ... }:
      let
        cfg = config.modules.services;
        dashboardDir = pkgs.runCommand "fleet-grafana-dashboards" { } ''
          mkdir -p "$out"
          cp ${./monitoring/fleet-overview.json} "$out/fleet-overview.json"
        '';
      in
      {
        services.prometheus = {
          enable = true;
          listenAddress = "127.0.0.1";
          port = 9090;
          stateDir = "prometheus2";
          retentionTime = "30d";
          extraFlags = [ "--storage.tsdb.retention.size=3GB" ];
          globalConfig.scrape_interval = "30s";
          scrapeConfigs = [
            {
              job_name = "node";
              static_configs = map (host: {
                targets = [
                  "${if host == "epsilon" then "127.0.0.1" else cfg.hostAddresses.${host}}:9100"
                ];
                labels.host = host;
              }) [ "alpha" "pi" "epsilon" ];
            }
          ];
        };

        services.grafana = {
          enable = true;
          openFirewall = false;
          settings = {
            server = {
              http_addr = "127.0.0.1";
              http_port = 3001;
              domain = "metrics.${cfg.domain}";
              root_url = "https://metrics.${cfg.domain}/";
              enforce_domain = true;
            };
            security = {
              # File provider keeps the password out of the Nix store. The
              # first-start secret is generated below and persisted on disk.
              admin_password = "$__file{/var/lib/grafana/admin-password}";
              cookie_secure = true;
              disable_gravatar = true;
            };
            users.allow_sign_up = false;
            analytics = {
              reporting_enabled = false;
              check_for_updates = false;
            };
          };
          provision = {
            datasources.settings = {
              apiVersion = 1;
              datasources = [
                {
                  name = "Prometheus";
                  type = "prometheus";
                  access = "proxy";
                  url = "http://127.0.0.1:9090";
                  uid = "fleet-prom";
                  isDefault = true;
                  editable = false;
                }
              ];
            };
            dashboards.settings = {
              apiVersion = 1;
              providers = [
                {
                  name = "Fleet";
                  type = "file";
                  disableDeletion = true;
                  editable = false;
                  options.path = dashboardDir;
                }
              ];
            };
          };
        };

        systemd.services.grafana.preStart = lib.mkBefore ''
          if [ ! -s /var/lib/grafana/admin-password ]; then
            umask 077
            ${pkgs.coreutils}/bin/head -c 32 /dev/urandom | ${pkgs.coreutils}/bin/base64 -w0 > /var/lib/grafana/admin-password
          fi
        '';

        # Epsilon has a tmpfs root. Without these binds Grafana's SQLite DB,
        # first-start credentials and all Prometheus metrics vanish on reboot.
        environment.persistence."/persist".directories = [
          {
            directory = "/var/lib/grafana";
            user = "grafana";
            group = "grafana";
            mode = "0750";
          }
          {
            directory = "/var/lib/prometheus2";
            user = "prometheus";
            group = "prometheus";
            mode = "0750";
          }
        ];
      };
  };
}
