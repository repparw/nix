diff --git c/apps/server/src/orchestration/threadTitles.ts i/apps/server/src/orchestration/threadTitles.ts
new file mode 100644
index 00000000..c9a9c4f7
--- /dev/null
+++ i/apps/server/src/orchestration/threadTitles.ts
@@ -0,0 +1,13 @@
+export const DEFAULT_THREAD_TITLE = "New thread";
+
+export function canReplaceThreadTitle(currentTitle: string, titleSeed?: string): boolean {
+  const trimmedCurrentTitle = currentTitle.trim();
+  if (trimmedCurrentTitle === DEFAULT_THREAD_TITLE) {
+    return true;
+  }
+
+  const trimmedTitleSeed = titleSeed?.trim();
+  return trimmedTitleSeed !== undefined && trimmedTitleSeed.length > 0
+    ? trimmedCurrentTitle === trimmedTitleSeed
+    : false;
+}
