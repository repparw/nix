+
+export type SessionStatus = "starting" | "running" | "ready" | "stopped" | "error" | "interrupted";
+
+const TERMINAL_STATUSES: ReadonlySet<SessionStatus> = new Set(["stopped", "error", "interrupted"] as const);
+const ACTIVE_STATUSES: ReadonlySet<SessionStatus> = new Set(["starting", "running", "ready"] as const);
+
+export function canReplaceSessionStatus(
+  currentStatus: SessionStatus,
+  nextStatus: SessionStatus,
+): boolean {
+  if (TERMINAL_STATUSES.has(currentStatus)) {
+    return true;
+  }
+  if (TERMINAL_STATUSES.has(nextStatus)) {
+    return true;
+  }
+  if (currentStatus === "ready" && ACTIVE_STATUSES.has(nextStatus)) {
+    return true;
+  }
+  return false;
+}
