variable "router_password" {
  description = "Archer AX23 admin password. Supply via TF_VAR_router_password; never commit."
  type        = string
  sensitive   = true
}

variable "router_host" {
  description = "Router management address (HTTP; this firmware serves local management over plain HTTP)."
  type        = string
  default     = "http://192.168.0.1"
}

variable "dhcp_reservations" {
  description = "Static DHCP reservations keyed by MAC address (dash-uppercase). Values generated by cmd/tfinventory."
  type = map(object({
    ip       = string
    hostname = optional(string, "")
    enabled  = optional(bool, true)
  }))
}

variable "port_forwards" {
  description = "Port forwarding (virtual server) rules keyed by rule name. Values generated by cmd/tfinventory."
  type = map(object({
    ip            = string
    external_port = string
    internal_port = string
    protocol      = string
    enabled       = optional(bool, true)
  }))
}
